{
  "name": "PlanMyCapital",
  "version": "1.0.0",
  "description": "PlanMyCapital investment calculator with username and password login.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -n api,web -c blue,green \"npm run server:dev\" \"npm run react\"",
    "server": "node server.js",
    "server:dev": "cross-env PORT=3001 node server.js",
    "react": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@microsoft/clarity": "^1.0.2",
    "@supabase/supabase-js": "^2.45.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.6.2",
    "chart.js": "^4.4.0",
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "openai": "^7.4.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "proxy": "http://localhost:3001",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "react-scripts": "5.0.1"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
